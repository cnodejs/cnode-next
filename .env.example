# .env.example — cnode-next 环境变量模板
# 复制为 .env 并填入实际值

# ── 应用 ──
APP_NAME=cnode-next
APP_ENV=development
APP_PORT=3001
APP_WEB_BASE_URL=http://localhost:5173
APP_API_BASE_URL=http://localhost:3001
APP_API_INTERNAL_BASE_URL=http://localhost:3001
CNODE_API_IMAGE=ghcr.io/cnodejs/cnode-api:sha-<commit>
CNODE_WEB_IMAGE=ghcr.io/cnodejs/cnode-web:sha-<commit>

# ── 数据库 (PostgreSQL-only) ──
DB_HOST=
DB_PORT=5432
DB_NAME=cnode_rehearsal
DB_USER=
DB_PASSWORD=
# Postgres 初始化 (docker postgres 镜像读这些)
POSTGRES_DB=cnode_rehearsal
POSTGRES_USER=cnode
POSTGRES_PASSWORD=

# ── Redis ──
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── 内容巡检 Worker ──
MODERATION_SCHEDULE_ENABLED=0
MODERATION_SCHEDULE_INTERVAL_MS=3600000
MODERATION_SCAN_BATCH_SIZE=200
MODERATION_SCAN_THROTTLE_MS=500
MODERATION_SCAN_MAX_BATCHES_PER_RUN=100

# ── 认证 / Session ──
AUTH_SESSION_SECRET=change-me
AUTH_COOKIE_DOMAIN=.cnodejs.org
AUTH_COOKIE_NAME=node_club
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=https://next.cnodejs.org/auth/github/callback

# ── 邮件 (SMTP) ──
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cnode@localhost
SMTP_FROM_NAME=CNode

# ── 阿里云 OSS ──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hongkong
OSS_ENDPOINT=
OSS_STATIC_HOST=https://static.cnodejs.org
OSS_UPLOAD_PREFIX=cnode-next/uploads
OSS_UPLOAD_EXPIRES=600

# ── Cloudflare ──
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Caddy (反代 + ACME, 仅生产) ──
CADDY_DOMAIN=api.cnodejs.org
CADDY_UPSTREAM=api:3001
