# .env.example - local development template.
# Copy to .env.local and fill local values. Production uses deployment/.env.production.example.

# Application
APP_NAME=cnode-next
APP_ENV=development
APP_PORT=3001
APP_WEB_BASE_URL=http://localhost:5173
APP_API_BASE_URL=http://localhost:3001
APP_API_INTERNAL_BASE_URL=http://localhost:3001

# Database: PostgreSQL only
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cnode_local
DB_USER=cnode
DB_PASSWORD=
POSTGRES_DB=cnode_local
POSTGRES_USER=cnode
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Moderation worker
MODERATION_SCHEDULE_ENABLED=0
MODERATION_SCHEDULE_INTERVAL_MS=3600000
MODERATION_SCAN_BATCH_SIZE=200
MODERATION_SCAN_THROTTLE_MS=500
MODERATION_SCAN_MAX_BATCHES_PER_RUN=100

# Auth and session
AUTH_SESSION_SECRET=change-me
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_NAME=node_club
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# Mail
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cnode@localhost
SMTP_FROM_NAME=CNode

# Object storage
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hongkong
OSS_ENDPOINT=
OSS_STATIC_HOST=http://localhost:3001
OSS_UPLOAD_PREFIX=cnode-next/uploads
OSS_UPLOAD_EXPIRES=600

# Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
