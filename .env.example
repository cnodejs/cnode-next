# .env.example - local development template.
# Copy to .env and fill local values. The deployment example is docs/deployment/env.production.example.
# The default local launcher reads only root .env. Use CNODE_ENV_FILE=.env.remote.local
# for an explicit private profile such as a remote rehearsal database.

# Application
CNODE_NAME=cnode-next
CNODE_ENV=development
CNODE_PORT=3001
CNODE_WEB_BASE_URL=http://localhost:5173
CNODE_API_BASE_URL=http://localhost:3001
CNODE_API_INTERNAL_BASE_URL=http://localhost:3001
CNODE_ADMINS=

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cnode_local
POSTGRES_USER=cnode
POSTGRES_PASSWORD=replace-with-local-postgres-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Authentication and session
AUTH_SESSION_SECRET=change-me
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_NAME=node_club
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# Mail
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cnode@localhost
SMTP_FROM_NAME=CNode

# Object storage
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hongkong
OSS_ENDPOINT=
OSS_STATIC_HOST=http://localhost:3001
OSS_UPLOAD_PREFIX=cnode-next/uploads
OSS_UPLOAD_EXPIRES=600

# Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Moderation worker
MODERATION_SCHEDULE_ENABLED=0
MODERATION_SCHEDULE_INTERVAL_MS=3600000
MODERATION_SCAN_BATCH_SIZE=200
MODERATION_SCAN_THROTTLE_MS=500
MODERATION_SCAN_MAX_BATCHES_PER_RUN=100

# OpenTelemetry tracing is disabled by default for local development.
CNODE_OTEL_ENABLED=0
CNODE_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
CNODE_OTEL_TRACE_SAMPLE_RATIO=0.1
