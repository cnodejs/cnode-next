# .env.example — cnode-next 环境变量模板
# 复制为 .env 并填入实际值

# ── 应用 ──
APP_NAME=cnode-next
APP_ENV=development
APP_PORT=3001
APP_API_BASE_URL=http://localhost:3001

# ── 数据库 (PostgreSQL-first) ──
DB_DIALECT=pg
DB_HOST=
DB_PORT=5432
DB_NAME=cnode_rehearsal
DB_USER=
DB_PASSWORD=
# Postgres 初始化 (docker postgres 镜像读这些)
POSTGRES_DB=cnode_rehearsal
POSTGRES_USER=cnode
POSTGRES_PASSWORD=

# ── Redis ──
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── 认证 / Session ──
AUTH_SESSION_SECRET=change-me
AUTH_COOKIE_DOMAIN=.cnodejs.org
AUTH_COOKIE_NAME=node_club
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_CALLBACK_URL=https://next.cnodejs.org/auth/github/callback

# ── 邮件 (SMTP) ──
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cnode@localhost
SMTP_FROM_NAME=CNode

# ── 阿里云 OSS ──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
OSS_STATIC_HOST=https://static.cnodejs.org

# ── Cloudflare ──
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# ── Caddy (反代 + ACME, 仅生产) ──
CADDY_DOMAIN=api.cnodejs.org
CADDY_UPSTREAM=api:3001
