{
  "name": "cnode-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm --filter @cnode/web dev\" \"pnpm --filter @cnode/api dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm verify:github-account-linking",
    "lint": "oxlint .",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @cnode/db db:push",
    "db:push:pg": "pnpm --filter @cnode/db db:push:pg",
    "db:seed": "pnpm --filter @cnode/db db:seed",
    "db:generate": "pnpm --filter @cnode/db db:generate",
    "migrate:mongo-to-pg": "tsx scripts/migrate-mongo-to-pg.ts",
    "migrate:reconcile": "tsx scripts/reconcile-migration.ts",
    "verify:api-contract": "tsx scripts/verify-api-contract.ts",
    "verify:admin-user-content-actions": "tsx scripts/verify-admin-user-content-actions.ts",
    "verify:container-image-delivery": "tsx scripts/verify-container-image-delivery.ts",
    "verify:admin-list-pagination": "tsx scripts/verify-admin-list-pagination.ts",
    "verify:moderation-helpers": "tsx scripts/verify-moderation-helpers.ts",
    "verify:moderation-scan": "tsx scripts/verify-moderation-scan-implementation.ts",
    "verify:moderation-scan:runtime": "tsx scripts/verify-moderation-scan-runtime.ts",
    "verify:public-content-visibility": "tsx scripts/verify-public-content-visibility.ts",
    "verify:topic-pin-management": "tsx scripts/verify-topic-pin-management.ts",
    "verify:github-id-uniqueness": "tsx scripts/check-duplicate-github-ids.ts",
    "verify:github-account-linking": "tsx scripts/verify-github-account-linking.ts",
    "verify:web-url-parity": "tsx scripts/verify-web-url-parity.ts",
    "format": "oxfmt .",
    "secrets:scan": "gitleaks git --config .gitleaks.toml --redact --no-banner",
    "secrets:scan:staged": "gitleaks git --config .gitleaks.toml --redact --no-banner --pre-commit --staged",
    "hooks:install": "husky",
    "prepare": "husky"
  },
  "dependencies": {
    "mongodb": "^5.9.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
