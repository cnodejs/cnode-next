#!/bin/sh
set -eu

if [ "${SKIP_GITLEAKS:-}" = "1" ]; then
  echo "[gitleaks] WARNING: SKIP_GITLEAKS=1 set; skipping pre-push secret scan. This is a risk operation." >&2
  exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[gitleaks] gitleaks is required for pushes." >&2
  echo "[gitleaks] Install it, then retry. See docs/security.md." >&2
  exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${local_ref:-}" ] || [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    log_opts="$local_sha --not --remotes"
  else
    log_opts="$remote_sha..$local_sha"
  fi

  echo "[gitleaks] scanning push range for $local_ref -> $remote_ref..."
  if ! gitleaks git --config .gitleaks.toml --redact --no-banner --log-opts "$log_opts"; then
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "[gitleaks] push blocked. Review findings or run the shown gitleaks command manually." >&2
  exit 1
fi
