{
  "name": "@cnode/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:pg": "drizzle-kit push",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cnode/shared": "workspace:*",
    "bcryptjs": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/uuid": "catalog:",
    "drizzle-kit": "^0.30.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
