{
  "description": "Core apps/web API dependencies checked against docs/api/openapi.yaml. Focuses on external topics, replies, users, collections, messages, auth, search, and system config calls.",
  "contracts": [
    { "method": "GET", "path": "/api/v1/topics", "auth": "none", "responseFields": ["success", "data", "total", "data.id", "data.author.loginname", "data.title", "data.reply_count", "data.visit_count"] },
    { "method": "GET", "path": "/api/v1/topic/{topic_id}", "auth": "optional", "responseFields": ["success", "data.id", "data.title", "data.content", "data.author.loginname", "data.replies", "data.replies.id", "data.replies.content", "data.replies.author.loginname", "data.replies.ups", "data.replies.is_uped"] },
    { "method": "POST", "path": "/api/v1/topics", "auth": "session-or-access-token", "responseFields": ["success", "topic_id"] },
    { "method": "POST", "path": "/api/v1/topics/update", "auth": "session-or-access-token", "responseFields": ["success", "topic_id"] },
    { "method": "POST", "path": "/api/v1/topic/{topic_id}/replies", "auth": "session-or-access-token", "responseFields": ["success", "reply_id"] },
    { "method": "GET", "path": "/api/v1/reply/{reply_id}", "auth": "session-or-access-token", "responseFields": ["success", "data.id", "data.content"] },
    { "method": "POST", "path": "/api/v1/reply/{reply_id}/edit", "auth": "session-or-access-token", "responseFields": ["success", "reply_id"] },
    { "method": "POST", "path": "/api/v1/reply/{reply_id}/delete", "auth": "session-or-access-token", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/reply/{reply_id}/ups", "auth": "session-or-access-token", "responseFields": ["success", "action"] },
    { "method": "GET", "path": "/api/v1/user/{loginname}", "auth": "optional", "responseFields": ["success", "data.loginname", "data.avatar_url", "data.create_at", "data.score", "data.recent_topics", "data.recent_replies", "data.is_block", "data.is_muted"] },
    { "method": "GET", "path": "/api/v1/user/{loginname}/topics", "auth": "none", "responseFields": ["success", "data", "total", "user.loginname"] },
    { "method": "GET", "path": "/api/v1/user/{loginname}/replies", "auth": "none", "responseFields": ["success", "data", "total", "user.loginname"] },
    { "method": "GET", "path": "/api/v1/user/{loginname}/collections", "auth": "none", "responseFields": ["success", "data", "total", "user.loginname"] },
    { "method": "GET", "path": "/api/v1/users/stars", "auth": "none", "responseFields": ["success", "data", "data.loginname", "data.avatar_url"] },
    { "method": "GET", "path": "/api/v1/users/top100", "auth": "none", "responseFields": ["success", "data", "data.loginname", "data.avatar_url"] },
    { "method": "GET", "path": "/api/v1/topic_collect/{loginname}", "auth": "none", "responseFields": ["success", "data", "data.id", "data.title", "data.author.loginname"] },
    { "method": "POST", "path": "/api/v1/topic_collect/collect", "auth": "session-or-access-token", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/topic_collect/de_collect", "auth": "session-or-access-token", "responseFields": ["success"] },
    { "method": "GET", "path": "/api/v1/messages", "auth": "session-or-access-token", "responseFields": ["success", "data.has_read_messages", "data.hasnot_read_messages", "data.hasnot_read_messages.id", "data.hasnot_read_messages.reply.content"] },
    { "method": "GET", "path": "/api/v1/message/count", "auth": "session-or-access-token", "responseFields": ["success", "data"] },
    { "method": "POST", "path": "/api/v1/message/mark_all", "auth": "session-or-access-token", "responseFields": ["success", "marked_msgs"] },
    { "method": "POST", "path": "/api/v1/message/mark_one/{msg_id}", "auth": "session-or-access-token", "responseFields": ["success", "marked_msg_id"] },
    { "method": "GET", "path": "/api/v1/auth/config", "auth": "none", "responseFields": ["success", "data.allow_signup"] },
    { "method": "POST", "path": "/api/v1/auth/local/signup", "auth": "none", "responseFields": ["success"] },
    { "method": "GET", "path": "/api/v1/auth/me", "auth": "session", "responseFields": ["success", "data.loginname", "data.avatar_url"] },
    { "method": "POST", "path": "/api/v1/auth/signout", "auth": "session", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/auth/local/login", "auth": "none", "responseFields": ["success"] },
    { "method": "GET", "path": "/api/v1/auth/local/active_account", "auth": "none", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/auth/local/search_pass", "auth": "none", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/auth/local/reset_pass", "auth": "none", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/auth/local/setting", "auth": "session", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/auth/local/change_pass", "auth": "session", "responseFields": ["success"] },
    { "method": "GET", "path": "/api/v1/auth/github/pending", "auth": "session", "responseFields": ["success", "data"] },
    { "method": "POST", "path": "/api/v1/auth/github/create", "auth": "session", "responseFields": ["success"] },
    { "method": "GET", "path": "/api/v1/auth/github/callback", "auth": "none", "responseFields": [] },
    { "method": "POST", "path": "/api/v1/auth/github/unbind", "auth": "session", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/user/refresh_token", "auth": "session", "responseFields": ["success", "accessToken"] },
    { "method": "GET", "path": "/api/v1/search", "auth": "none", "responseFields": ["success", "data"] },
    { "method": "GET", "path": "/api/v1/sidebar/home", "auth": "none", "responseFields": ["success", "data"] },
    { "method": "POST", "path": "/api/v1/upload/image", "auth": "session", "responseFields": ["success", "url"] },
    { "method": "GET", "path": "/api/v1/admin/reports", "auth": "admin-or-mod", "responseFields": ["success", "data", "total"] },
    { "method": "POST", "path": "/api/v1/admin/reports", "auth": "session", "responseFields": ["success"] },
    { "method": "POST", "path": "/api/v1/admin/reply/{reply_id}/delete", "auth": "admin-or-mod", "responseFields": ["success"] }
  ]
}
