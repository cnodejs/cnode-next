# Reference dotenv template for the repository Compose baseline.
# Copy to an ignored .env file and replace placeholders for the target environment.
# Do not commit real secrets, tokens, private keys, database URLs, or user data.

# Application
CNODE_ENV=production
CNODE_ADMINS=
CNODE_WEB_BASE_URL=https://web.example.com
CNODE_API_BASE_URL=https://api.example.com
CNODE_API_INTERNAL_BASE_URL=http://api:3001

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cnode
POSTGRES_USER=cnode
POSTGRES_PASSWORD=replace-with-postgres-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Authentication and session
AUTH_SESSION_SECRET=replace-with-session-secret
AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_NAME=node_club
AUTH_GITHUB_CLIENT_ID=replace-with-github-client-id
AUTH_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
AUTH_GITHUB_CALLBACK_URL=https://web.example.com/auth/github/callback

# Mail
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=25
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=cnode@example.com
SMTP_FROM_NAME=CNode

# Object storage
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
OSS_BUCKET=replace-with-oss-bucket
OSS_REGION=replace-with-oss-region
OSS_ENDPOINT=replace-with-oss-endpoint
OSS_STATIC_HOST=https://static.example.com
OSS_UPLOAD_PREFIX=cnode-next/uploads
OSS_UPLOAD_EXPIRES=600

# Turnstile
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Moderation worker
MODERATION_SCHEDULE_ENABLED=0
MODERATION_SCHEDULE_INTERVAL_MS=3600000
MODERATION_SCAN_BATCH_SIZE=200
MODERATION_SCAN_THROTTLE_MS=500
MODERATION_SCAN_MAX_BATCHES_PER_RUN=100

# Observability
CNODE_OTEL_ENABLED=1
CNODE_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
CNODE_OTEL_TRACE_SAMPLE_RATIO=0.1

# OpenObserve service
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=replace-with-openobserve-root-password

# OpenTelemetry Collector
OPENOBSERVE_OTLP_ENDPOINT=https://metrics.example.com/api/default
OPENOBSERVE_AUTH_TOKEN=replace-with-base64-ingestion-token

# Deployment
CNODE_API_IMAGE=ghcr.io/cnodejs/cnode-api:sha-commit
CNODE_WEB_IMAGE=ghcr.io/cnodejs/cnode-web:sha-commit

# Adminer
ADMINER_PORT=8080
