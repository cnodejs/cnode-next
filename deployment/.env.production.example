# Production dotenv template for deployment/docker-compose.prod.yml.
# Copy to the server as .env and replace placeholders there.
# Do not commit real secrets, tokens, private keys, database URLs, or user data.

# Application URLs and images
APP_ENV=production
APP_PORT=3001
APP_WEB_BASE_URL=https://cnodejs.org
APP_API_BASE_URL=https://api.cnodejs.org
APP_API_INTERNAL_BASE_URL=http://api:3001
CNODE_API_IMAGE=ghcr.io/cnodejs/cnode-api:sha-commit
CNODE_WEB_IMAGE=ghcr.io/cnodejs/cnode-web:sha-commit
LEGACY_DOCKER_NETWORK=cnode

# Database: PostgreSQL only
POSTGRES_DB=cnode
POSTGRES_USER=cnode
POSTGRES_PASSWORD=replace-with-postgres-password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cnode
DB_USER=cnode
DB_PASSWORD=replace-with-postgres-password

# Redis
REDIS_HOST=cnode-next-redis-1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication and session
APP_ADMINS=
AUTH_SESSION_SECRET=replace-with-session-secret
AUTH_COOKIE_DOMAIN=.cnodejs.org
AUTH_COOKIE_NAME=node_club
AUTH_GITHUB_CLIENT_ID=replace-with-github-client-id
AUTH_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
AUTH_GITHUB_CALLBACK_URL=https://cnodejs.org/auth/github/callback

# Object storage
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
OSS_BUCKET=replace-with-oss-bucket
OSS_REGION=oss-cn-hongkong
OSS_ENDPOINT=replace-with-oss-endpoint
OSS_STATIC_HOST=https://static.cnodejs.org
OSS_UPLOAD_PREFIX=cnode-next/uploads
OSS_UPLOAD_EXPIRES=600

# Turnstile
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Mail
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=25
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=cnode@example.com
SMTP_FROM_NAME=CNode

# Observability and logging
LOG_LEVEL=info

# Migration and operations
MONGO_URI=mongodb://replace-with-mongo-host/cnode
MONGO_DB=cnode
MIGRATION_TARGET=rehearsal
MIGRATION_REPORT_PATH=/app/migration-reports/migration-report.json
MODERATION_SCHEDULE_ENABLED=0
MODERATION_SCHEDULE_INTERVAL_MS=3600000
MODERATION_SCAN_BATCH_SIZE=200
MODERATION_SCAN_THROTTLE_MS=500
MODERATION_SCAN_MAX_BATCHES_PER_RUN=100
